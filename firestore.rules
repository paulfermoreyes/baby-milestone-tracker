rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    // Returns true if the requesting user is authenticated
    function isAuthed() {
      return request.auth != null;
    }

    // Returns true if the requesting user owns the resource (legacy root collections)
    function ownsResource() {
      return isAuthed() && resource.data.userId == request.auth.uid;
    }

    // Returns true if the requesting user is a member of the given family document
    function isFamilyMember(familyId) {
      return isAuthed() &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    // ── User profile documents ───────────────────────────────────────────────
    match /users/{userId} {
      // Users can only read and write their own profile
      allow read, write: if isAuthed() && request.auth.uid == userId;

      // Birth Preparation Checklist (solo, cross-device)
      match /checklist/{checklistId} {
        allow read, write: if isAuthed() && request.auth.uid == userId;
      }

      // Newborn Baby subcollections for solo users
      match /babies/{babyId} {
        allow read, write: if isAuthed() && request.auth.uid == userId;

        match /{allSubcollections=**} {
          allow read, write, delete: if isAuthed() && request.auth.uid == userId;
        }
      }
    }

    // ── Invites ──────────────────────────────────────────────────────────────
    // Invite flow (no Cloud Functions):
    //  1. A family member creates invites/{code} (random, unguessable code) pointing at their familyId,
    //     expiring within 7 days.
    //  2. The invitee does a get() on invites/{code} (listing is not allowed, so codes can't be enumerated).
    //  3. The invitee updates families/{familyId}, appending only their own uid to `members` and setting
    //     `joinedWithCode`; rules verify the invite exists, matches the family and has not expired.
    //  4. In the same batch the invitee deletes the invite (allowed because they are then a member).
    match /invites/{code} {
      allow get: if isAuthed();

      allow create: if isAuthed()
        && request.resource.data.keys().hasOnly(['familyId', 'createdBy', 'expiresAt', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.familyId is string
        && isFamilyMember(request.resource.data.familyId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');

      allow delete: if isAuthed() && (
        resource.data.createdBy == request.auth.uid
        || request.auth.uid in getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.members
      );

      allow list, update: if false;
    }

    // ── Family documents ─────────────────────────────────────────────────────
    match /families/{familyId} {
      // Authenticated user creates a family as its sole member (no invite code fields on the doc)
      allow create: if isAuthed()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members == [request.auth.uid]
        && !request.resource.data.keys().hasAny(['inviteCode', 'inviteCodeExpiresAt', 'joinedWithCode']);

      // Only family members can read the family doc
      allow read: if isAuthed() && request.auth.uid in resource.data.members;

      allow update: if isAuthed() && (
        // (a) existing member updating without altering membership
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members)
        // (b) JOIN via a valid invite: only append self and set joinedWithCode
        || (!(request.auth.uid in resource.data.members)
          && request.resource.data.members.size() <= 2
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinedWithCode'])
          && request.resource.data.joinedWithCode is string
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.joinedWithCode))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinedWithCode)).data.familyId == familyId
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinedWithCode)).data.expiresAt > request.time)
      );

      // Nobody can delete a family document from the client
      allow delete: if false;

      // ── Shared tracker subcollections ──────────────────────────────────────

      // Kicks
      match /kicks/{kickId} {
        allow read, delete: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && request.resource.data.loggedBy == request.auth.uid;
        allow update: if false;
      }

      // Contractions
      match /contractions/{contractionId} {
        allow read, delete: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && request.resource.data.loggedBy == request.auth.uid;
        allow update: if false;
      }

      // Blood sugar
      match /bloodsugar/{bsId} {
        allow read, delete: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && request.resource.data.loggedBy == request.auth.uid;
        allow update: if false;
      }

      // Milk counter
      match /milk/{milkId} {
        allow read, delete: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && request.resource.data.loggedBy == request.auth.uid;
        allow update: if false;
      }

      // Symptoms
      match /symptoms/{symptomId} {
        allow read, delete: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && request.resource.data.loggedBy == request.auth.uid;
        allow update: if false;
      }

      // Weight
      match /weight/{weightId} {
        allow read, delete: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && request.resource.data.loggedBy == request.auth.uid;
        allow update: if false;
      }

      // Baptism Organizer
      match /baptism/{baptismId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // Birth Preparation Checklist
      match /checklist/{checklistId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // Newborn Baby Profiles & Tracking Subcollections
      match /babies/{babyId} {
        allow read, write: if isFamilyMember(familyId);

        match /{allSubcollections=**} {
          allow read, write, delete: if isFamilyMember(familyId);
        }
      }
    }

    // ── Legacy root collections (personal, pre-link) ─────────────────────────
    // These remain for users who haven't linked with a partner yet.

    match /kicks/{kickId} {
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if ownsResource();
      allow update: if false;
    }

    match /milk/{milkId} {
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if ownsResource();
      allow update: if false;
    }

    match /bloodsugar/{bsId} {
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if ownsResource();
      allow update: if false;
    }

    match /contractions/{contractionId} {
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if ownsResource();
      allow update: if false;
    }

    match /symptoms/{symptomId} {
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if ownsResource();
      allow update: if false;
    }

    match /weight/{weightId} {
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if ownsResource();
      allow update: if false;
    }

    match /baptism/{baptismId} {
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthed() && (resource.data.userId == request.auth.uid || baptismId == request.auth.uid);
    }
  }
}
